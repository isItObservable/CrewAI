# ── CopilotKit LLM backend ───────────────────────────────────────────────────
# Option A: Ollama (local, key-free) — point at your Ollama host
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6

# Option B: OpenAI (requires API key)
# OPENAI_API_KEY=sk-...

# Option C: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Select which adapter the CopilotKit runtime uses: ollama | openai | anthropic
COPILOTKIT_ADAPTER=ollama

# ── BMAD Crew FastAPI backend ─────────────────────────────────────────────────
# URL of the bmad-crew FastAPI service (no trailing slash)
# Local: http://localhost:8000
# In-cluster: http://bmad-crew.bmad-crew.svc.cluster.local
BMAD_CREW_URL=http://localhost:8000

# ── Next.js public vars (accessible in browser) ───────────────────────────────
# These are injected into the browser bundle; do NOT put secrets here.
NEXT_PUBLIC_BMAD_CREW_URL=http://localhost:8000
