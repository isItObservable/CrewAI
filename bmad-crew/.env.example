# Copy to .env and adjust. No external LLM key is needed — we run against local qwen.

# --- LLM (local qwen via Ollama on the Mac Studio) ---
MODEL=ollama/qwen3.6
OLLAMA_BASE_URL=http://<your-ollama-host>:11434
MODEL_TEMPERATURE=0.4

# --- OpenTelemetry (OpenLIT) ---
# Point at your OTel Collector gateway. Leave unset to run without telemetry.
# In k8s this is injected from the ConfigMap (see k8s/configmap.yaml).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=bmad-crew
# OPENLIT_CAPTURE_CONTENT=true    # set false to redact prompts/completions from spans
# OTEL_SDK_DISABLED=true          # hard off-switch for all telemetry

# --- CrewAI native telemetry (anonymous product analytics) ---
# Disabled by observability.py; set here too for defence in depth.
CREWAI_DISABLE_TELEMETRY=true

# --- GitHub (optional) — let the crew actually WORK ON GITHUB via the GitHub MCP server ---
# See bmad-crew/GITHUB_TOOLS.md. Unset = crew runs key-free and writes only to ./output.
# Use a FINE-GRAINED PAT scoped to ONLY the repos the crew may touch, minimum permissions
# (typically Contents + Issues + Pull requests: read/write). Each tool call is traced as a
# `tool <name>` span (observability/OBSERVABILITY.md §6).
# GITHUB_PERSONAL_ACCESS_TOKEN=
# GITHUB_MCP_MODE=remote                               # 'remote' (GitHub-hosted) or 'docker' (local server)
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/    # remote endpoint (default)
# GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server    # only used when GITHUB_MCP_MODE=docker
