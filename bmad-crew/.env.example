# Copy to .env and adjust. No external LLM key is needed — we run against local qwen.

# --- LLM (local qwen via Ollama on the Mac Studio) ---
MODEL=ollama/qwen3.6
OLLAMA_BASE_URL=http://10.0.0.185:11434
MODEL_TEMPERATURE=0.4

# --- OpenTelemetry (OpenLIT) ---
# Point at your OTel Collector gateway. Leave unset to run without telemetry.
# In k8s this is injected from the ConfigMap (see k8s/configmap.yaml).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=bmad-crew
# OPENLIT_CAPTURE_CONTENT=true    # set false to redact prompts/completions from spans
# OTEL_SDK_DISABLED=true          # hard off-switch for all telemetry

# --- CrewAI native telemetry (anonymous product analytics) ---
# Disabled by observability.py; set here too for defence in depth.
CREWAI_DISABLE_TELEMETRY=true
