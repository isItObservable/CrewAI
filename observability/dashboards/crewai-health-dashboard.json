    "tiles": {
      "0": {
        "content": "# \ud83e\ude7a CrewAI \u2014 Health & Availability\nComponent, operator & agent health for the **observable-crewai** cluster: Kubernetes workload state (DynaKube), agent-service RED metrics, agent-run success & logs.",
        "type": "markdown"
      },
      "1": {
        "content": "## Overview",
        "type": "markdown"
      },
      "10": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "timeseries mem = avg(dt.kubernetes.container.memory_working_set), by:{k8s.workload.name}, filter:{ k8s.cluster.name == \"observable-crewai\" and k8s.namespace.name == \"crewai\" }",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
        "title": "Container Memory Working Set by Workload",
        "type": "data",
        "visualization": "lineChart",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "chartSettings": {
            "legend": {
              "position": "bottom"
            }
          },
          "coloring": {
            "colorRules": [
              {
                "colorMode": "color-palette",
                "colorPalette": "purple-rain",
                "comparator": "= *value*",
                "field": "DT.name",
                "type": "string",
                "value": ""
              }
            ]
          }
        }
      },
      "11": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "timeseries thr = avg(dt.kubernetes.container.cpu_throttled), by:{k8s.workload.name}, filter:{ k8s.cluster.name == \"observable-crewai\" and k8s.namespace.name == \"crewai\" }",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
        "title": "CPU Throttling by Workload",
        "type": "data",
        "visualization": "lineChart",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "chartSettings": {
            "legend": {
              "position": "bottom"
            }
          },
          "coloring": {
            "colorRules": [
              {
                "colorMode": "color-palette",
                "colorPalette": "purple-rain",
                "comparator": "= *value*",
                "field": "DT.name",
                "type": "string",
                "value": ""
              }
            ]
          }
        }
      },
      "12": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "timeseries rx = avg(dt.kubernetes.pod.network_received_data), tx = avg(dt.kubernetes.pod.network_transmitted_data), filter:{ k8s.cluster.name == \"observable-crewai\" and k8s.namespace.name == \"crewai\" }",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
        "title": "Pod Network I/O",
        "type": "data",
        "visualization": "lineChart",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "chartSettings": {
            "legend": {
              "position": "bottom"
            }
          },
          "coloring": {
            "colorRules": [
              {
