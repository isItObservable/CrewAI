        "query": "fetch spans\n| filter coalesce(gen_ai.provider.name, gen_ai.system) == \"crewai\" and `gen_ai.operation.name` == \"invoke_agent\"\n| summarize runs = count(), failed = countIf(span.status_code == \"ERROR\"), by:{agent = `gen_ai.agent.name`}\n| sort runs desc",
