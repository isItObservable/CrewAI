      "20": {
        "content": "## Efficiency KPIs & Tool Quality \u2014 ISI-1571 additions\nCost/throughput KPIs and tool reliability derived from spans. Signals: tokens-per-run, tool latency & `isError` rate, run/LLM latency percentiles, finish reasons, MCP-vs-builtin tool split. _ISI-1571 / ISI-1570._",
        "type": "markdown"
      },
      "21": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch spans\n| filter gen_ai.system == \"crewai\" and (`gen_ai.operation.name` == \"chat\" or `gen_ai.operation.name` == \"invoke_agent\")\n| summarize tok = sum(toLong(`gen_ai.usage.input_tokens`)) + sum(toLong(`gen_ai.usage.output_tokens`)), runs = countIf(`gen_ai.operation.name` == \"invoke_agent\")\n| fieldsAdd TokensPerRun = if(runs > 0, toDouble(tok) / runs, else: 0.0)\n| fields TokensPerRun",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
        "title": "Avg Tokens / Run",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "label": "input+output / invoke_agent",
            "recordField": "TokensPerRun",
            "sparklineSettings": {
              "isVisible": false
            },
            "trend": {
              "isVisible": false
            }
          }
        }
      },
      "22": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch spans\n| filter gen_ai.system == \"crewai\" and `gen_ai.operation.name` == \"execute_tool\"\n| summarize total = count(), errors = countIf(span.status_code == \"ERROR\")\n| fieldsAdd ErrPct = if(total > 0, toDouble(errors) / total * 100, else: 0.0)\n| fields ErrPct",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
        "title": "Tool Error Rate (%)",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
